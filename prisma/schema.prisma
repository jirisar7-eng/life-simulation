datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Entity {
  id            String   @id
  type          String
  parentId      String?
  createdAtTick Int?
  tags          String[] @default([])
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([parentId])
}
